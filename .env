# Database Connection
# For local SQLite zero-dependency mode:
DATABASE_URL="file:./prisma/dev.db"

# For PostgreSQL deployment (Uncomment and set your Postgres URL):
# DATABASE_URL="postgresql://postgres:your_password@localhost:5432/rakib_sensi?schema=public"

# Authentication & Session Security (Replace with a random 32+ char key in production)
AUTH_SECRET="rakib-sensi-secure-jwt-key-development-32chars-2025"

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Default Locale (bn, en, ja)
NEXT_PUBLIC_DEFAULT_LOCALE="bn"

# Official Agency WhatsApp Number
NEXT_PUBLIC_DEFAULT_WHATSAPP="8801341017323"
